// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Anyone can read the garden and add a well-formed flower; nobody can edit or delete.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /flowers/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['f', 'x', 'h', 'r', 't'])
        && request.resource.data.f in ['daisy', 'tulip', 'sprig']
        && request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 100
        && request.resource.data.h is number && request.resource.data.h >= 58 && request.resource.data.h <= 108
        && request.resource.data.r is number && request.resource.data.r >= -10 && request.resource.data.r <= 10
        && request.resource.data.t == request.time;
      allow update, delete: if false;
    }
  }
}
